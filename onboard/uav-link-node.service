# 安裝：
#   sudo cp uav-link-node.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now uav-link-node
[Unit]
Description=UAV 5G link telemetry node
After=network-online.target
Wants=network-online.target

[Service]
# 設定都在 /opt/uav-onboard/.env（cp .env.example .env 後編輯），
# 腳本自動讀取——本檔只需在安裝路徑不同時改路徑。
WorkingDirectory=/opt/uav-onboard
ExecStart=/usr/bin/python3 /opt/uav-onboard/onboard_node.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
