    "/api/command/{sysid}/mission/change-route": {
      "post": {
        "description": "**第二步：執行三步序列。** 每一步都讀回機端確認，任何一步沒過就停在\n安全狀態（懸停），不會繼續往一個沒人確認過的方向飛。\n\n**執行當下重算提案**（協定 §5.1）：人確認的是**那一份**提案，而飛機在\n人看提案的那段時間裡一直在動。續飛航點換了、或距離變化超過門檻，就中止\n並回新的提案要人重看——不照著過期的提案做。",
        "operationId": "change_route_exec_api_command__sysid__mission_change_route_post",
        "parameters": [
          {
            "in": "path",
            "name": "sysid",
            "required": true,
            "schema": {
              "title": "Sysid",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeRouteIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Change Route Exec"
      }
    },
    "/api/command/{sysid}/mission/change-route/proposal": {
      "post": {
        "description": "**飛行中改航線的第一步：提案。這個端點不動飛機。**\n\n回傳「會怎麼調整」——狀態機文件 §6.3 要求確認畫面不得只問「確定嗎？」，\n因為那種確認框沒有資訊，人只會照按。所以這裡算得出：續飛到哪一點、\n離現在多遠、往哪個方向、會不會先爬升或下降、以及這是可中止的三步序列。\n\n**在地上不需要走這條路**：地面上傳是存檔，直接用 mission/upload。\n確認要保持稀有才有意義——每次上傳都跳確認框，會訓練人閉著眼睛按，\n然後空中那次也照按（§6.3 明文禁止把它做成 upload 的預設行為）。",
        "operationId": "change_route_proposal_api_command__sysid__mission_change_route_proposal_post",
        "parameters": [
          {
            "in": "path",
            "name": "sysid",
            "required": true,
            "schema": {
              "title": "Sysid",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeRouteIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Change Route Proposal"
      }
    },
    "/api/command/{sysid}/mission/fly": {
      "post": {
        "description": "起飛→任務自動序列（實戰教訓 2026-08-11：地面直接 MISSION_START\n在實機上會失敗，須先到高度）：\n\n  （上傳＋回讀比對）→ 解鎖 → NAV_TAKEOFF → **等實際到達目標高度**\n  → 切 AUTO.MISSION（已在空中，PX4 跳過任務內的 takeoff 項續飛）\n\n高度沒到就不切任務——序列在任何一步失敗都停在安全狀態\n（PX4 起飛後自動懸停），並回報卡在哪一步。",
        "operationId": "mission_fly_api_command__sysid__mission_fly_post",
        "parameters": [
          {
            "in": "path",
            "name": "sysid",
            "required": true,
            "schema": {
              "title": "Sysid",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FlyIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Mission Fly",
        "tags": [
          "一鍵"
        ]
      }
    },
    "/api/command/{sysid}/mission/goto": {
      "post": {
        "description": "從指定的航點續飛（issues/039 的「續飛」）。\n\n參數是**我方索引**而不是機端 seq：機端 seq 的慣例因廠牌而異\n（ArduPilot 的 home 佔 0），讓呼叫端算＝把方言洩漏到每一個呼叫點。",
        "operationId": "mission_goto_api_command__sysid__mission_goto_post",
        "parameters": [
