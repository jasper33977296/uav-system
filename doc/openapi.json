            "description": "Validation Error"
          }
        },
        "summary": "Mission Goto"
      }
    },
    "/api/command/{sysid}/mission/start": {
      "post": {
        "description": "讓飛控開始執行**它機上現有**的那份任務（不帶任務內容——那是上一步的事）。\n\n**機必須已經解鎖並在空中**：對停在地面的機切自動任務模式，等於叫它自己起飛。\n要從地面一路到飛，用 `/api/command/{sysid}/mission/fly` 或 `/api/start`。",
        "operationId": "mission_start_api_command__sysid__mission_start_post",
        "parameters": [
          {
            "in": "path",
            "name": "sysid",
            "required": true,
            "schema": {
              "title": "Sysid",
              "type": "integer"
            }
