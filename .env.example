# 複製為 .env（scripts/setup.sh 也會自動產生並挑選可用連接埠）。
# docker compose 與 dev 腳本都讀這個檔——新環境部署只需改這裡。

# ── 連接埠（專案慣例：30000 以上）──────────────────────────
DB_PORT=35432
BACKEND_PORT=38000
FRONTEND_PORT=33000

# ── 部署模式 ──────────────────────────────────────────────
# simulated＝開發（SITL＋模擬 5G 鏈路）
# modem    ＝真機（鏈路量測由機上 ROS node POST 進來；見 doc/deployment.md）
LINK_SOURCE=simulated

# 無人機的名稱與「主機」指定改由系統端管理（無人機頁：註冊／改名／設為主機），
# 不在此設定。全新環境會自動建立預設主機 uav-1，開站後改名即可。

# MAVLink 監聽位址（機上/SITL 把遙測送到本機此埠；一般不用改）
MAVLINK_URL=udpin://0.0.0.0:14540

# ── 指令服務（GCS 取代階段 2；doc/gcs-replacement.md）────────
# 預設關：只觀察不指揮。要從本系統上傳任務/起飛/RTL 時顯式開啟。
COMMAND_PORT=38001
ENABLE_COMMANDS=false
# 生產＝機上 router 的 command 端點（14541）；SITL 開發改 14550：
# COMMAND_MAVLINK_URL=udpin://0.0.0.0:14550

# ── 開發模式開關 ──────────────────────────────────────────
# 範本預設＝部署形：前端跑 production build（next start）、無模擬器。
# 開發環境由 scripts/setup.sh 自動加上下面兩行（或自行取消註解）：
# COMPOSE_PROFILES=sim                                        # SITL 模擬器
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml      # 前端熱重載
